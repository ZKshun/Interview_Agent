{
  "name": "interview-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:demo": "cross-env LLM_MODE=demo npm run dev",
    "start": "npm run start -w server",
    "build": "npm run build -w web",
    "test": "npm run test -w server",
    "test:e2e": "playwright test",
    "format": "prettier --write \"server/**/*.js\" \"web/src/**/*.{js,vue,css}\" \"web/e2e/*.js\" \"*.{js,json}\" \"web/*.{js,json,html}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.10.1"
  }
}
